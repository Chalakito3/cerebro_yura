# Copia este archivo como .env.local y pon tus claves reales.
# Luego protégelo con: chmod 600 .env.local
GROQ_API_KEY=
GEMINI_API_KEY=
# Contraseña para ver /resultados desde otro equipo de la red (usuario: cualquiera).
# Sin contraseña, los resultados solo se ven desde la computadora de Yura.
YURA_RESULTADOS_CLAVE=
# Voz de Yura (opcional). Por defecto es-BO-SofiaNeural (boliviana). Otras: es-BO-MarceloNeural.
YURA_VOZ=
# Gemini para reconocer la voz (opcional, 20 usos gratis al día). Por defecto desactivado: 1 para activarlo.
YURA_GEMINI_ENABLED=

# 1 = después de Yura suena la grabación de la docente (modo docente). Por defecto no suena.
YURA_VOZ_DOCENTE=
# Modelo de Gemini para reconocer la voz (solo si YURA_GEMINI_ENABLED=1). Por defecto gemini-3.8-flash.
YURA_GEMINI_TRANSCRIBE_MODEL=
# Modelo de Groq para conversar. Por defecto openai/gpt-oss-120b.
YURA_GROQ_MODEL=
# Modelo de Whisper local para reconocer la voz. Por defecto small (base es más rápido pero entiende menos).
YURA_WHISPER_MODEL=
# Número (índice) del micrófono y del parlante (opcional). Si se dejan vacíos, Yura busca los audífonos USB y la salida actual.
YURA_INPUT_DEVICE=
YURA_OUTPUT_DEVICE=
# 1 = "apágate" también apaga la computadora. Por defecto solo se cierra Yura.
YURA_APAGAR_EQUIPO=
# 1 = muestra en la terminal lo que dicen los estudiantes y los detalles del audio (solo para revisar fallas).
YURA_DEBUG=
# 1 = las palabras quechuas suenan con la pronunciación de la docente llevada a la voz de Yura
# (basedatos/entrenar_voz_yura.py). Por defecto no: Yura mantiene su voz natural.
YURA_VOZ_AUDIO_APRENDIDO=
# 0 = la voz no usa la escritura aprendida de los audios (basedatos/aprender_pronunciacion.py). Por defecto sí.
YURA_PRONUNCIACION_APRENDIDA=

# Motor ASR: auto (vacío), vosk o whisper. Auto usa Whisper con GPU NVIDIA y Vosk sin ella.
# Vosk necesita el modelo local en model/.
YURA_ASR=

# Actividades de clase desde Laravel (contrato v1.2: documentacion_pruebas/yura-activity-contract-v1.md).
# 1 = Yura pide actividades cuando está libre en el menú. Por defecto 0: no se conecta.
YURA_LARAVEL_SYNC_ENABLED=
# Raíz de Laravel, sin /api al final. HTTPS (HTTP solo en una red privada).
YURA_LARAVEL_URL=
# Token Sanctum de la cuenta con rol robot. Lo pone el dueño; nunca va a git.
YURA_LARAVEL_TOKEN=
# Segundos entre consultas a Laravel (por defecto 15, mínimo 5).
YURA_LARAVEL_INTERVALO=
# Diccionario de las actividades (opcional). Si no existe, se usa diccionario.db.
YURA_DICTIONARY_PATH=
