# Copia este archivo como .env.local y pon tus claves reales.
# Luego protégelo con: chmod 600 .env.local
GROQ_API_KEY=
GEMINI_API_KEY=
# Contraseña para ver /resultados desde otro equipo de la red (usuario: cualquiera).
# Sin contraseña, los resultados solo se ven desde la computadora de Yura.
YURA_RESULTADOS_CLAVE=
# Voz de Yura (opcional). Por defecto es-BO-SofiaNeural (boliviana). Otras: es-BO-MarceloNeural.
YURA_VOZ=
# Gemini para reconocer la voz (opcional, 20 usos gratis al día). Por defecto desactivado: 1 para activarlo.
YURA_GEMINI_ENABLED=
